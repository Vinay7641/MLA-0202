import numpy as np
image = np.array([
    [10, 10, 10, 10, 10],
    [10, 50, 50, 50, 10],
    [10, 50, 90, 50, 10],
    [10, 50, 50, 50, 10],
    [10, 10, 10, 10, 10]])
print("Original Image:")
print(image)
new_image = image.copy()
for i in range(1, 4):
    for j in range(1, 4):
        neighbors = [
            image[i-1, j],
            image[i+1, j],
            image[i, j-1],
            image[i, j+1]
        ]
        new_image[i, j] = int(np.mean(neighbors))
print("Updated Image:")
print(new_image)
