from sklearn.linear_model import Perceptron
X = [
    [5.1,3.5,1.4,0.2],
    [4.9,3.0,1.4,0.2],
    [6.2,3.4,5.4,2.3],
    [5.9,3.0,5.1,1.8],
    [5.5,2.4,3.8,1.1],
    [6.5,2.8,4.6,1.5]
]
y = [0,0,2,2,1,1]
model = Perceptron()
model.fit(X, y)
flower = [[5.1,3.5,1.4,0.2]]
print("Predicted Class:", model.predict(flower)[0])
